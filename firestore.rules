rules_version = '2';
// ====================================================================
//  REGLAS DE FIRESTORE — Sistema de Orquestas v4.0
//
//  Estas reglas son la ÚNICA barrera de seguridad real: todo lo que el
//  navegador "oculta" (botones, roles, pestañas) se puede saltar desde la
//  consola del navegador; lo que se decide acá, no.
//
//  Cambios respecto a v3 (resumen):
//   · usuarios: ya NO todo usuario logueado puede leer a todo el país.
//     Cada rol lee solo su alcance (su núcleo / su estado / todo si es nacional).
//   · usuarios: crear y borrar solo lo hace el backend (Admin SDK). Un
//     director_nacional ya no puede borrar ni editar a un owner_supremo.
//   · usuarios: lista blanca de campos editables (nadie se cambia su propio
//     rol, ni reactiva su cuenta, ni se cambia el correo).
//   · Cuenta desactivada = sin acceso a NINGUNA colección, aunque su sesión
//     siga abierta.
//   · flyers / eventos / agrupaciones / piezas / partituras: ya no escribe
//     cualquier admin en cualquier núcleo; solo en el suyo (nacional y
//     regional siguen pudiendo en todos).
//   · eventos: visibilidad por audiencia verificada en el servidor
//     (profesor / estudiante / agrupación), no solo en el navegador.
//   · Se elimina /contenido (las citas de la portada ya no son editables).
//
//  Después de publicarlas, probalas en Firebase Console → Firestore →
//  Reglas → "Simulador de reglas".
// ====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------
    function signedIn() { return request.auth != null; }
    function perfilPath() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function activo() {
      return signedIn() && exists(perfilPath()) && get(perfilPath()).data.cuentaActiva != false;
    }
    function me() { return get(perfilPath()).data; }
    function rol() { return me().rango; }

    function esOwner()     { return rol() == 'owner_supremo'; }
    function esNacional()  { return rol() in ['owner_supremo', 'director_nacional']; }
    function esRegional()  { return rol() == 'director_regional'; }
    function esDirNucleo() { return rol() == 'director_nucleo'; }
    function esAdmin()     { return rol() == 'admin'; }
    // "Gestores": quienes crean/editan contenido (= permiso manage_users del front)
    function esGestor() {
      return rol() in ['owner_supremo', 'director_nacional', 'director_regional', 'director_nucleo', 'admin'];
    }
    // Nacional y regional operan sobre varios núcleos; el resto, solo sobre el propio.
    function multiNucleo() { return esNacional() || esRegional(); }
    function esMiNucleo(nucleo) { return me().nucleo != '' && nucleo == me().nucleo; }

    // ---------- USUARIOS ----------
    function puedeLeerUsuario(u) {
      return esNacional()
        || esMiNucleo(u.nucleo)
        || (esRegional() && me().estado != '' && u.estado == me().estado)
        || (esRegional() && u.rango == 'director_nacional')
        || (esDirNucleo() && me().estado != '' && u.rango == 'director_regional' && u.estado == me().estado);
    }
    function camposCambiados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /usuarios/{userId} {
      allow get:  if activo() && (request.auth.uid == userId || puedeLeerUsuario(resource.data));
      allow list: if activo() && puedeLeerUsuario(resource.data);

      // Alta y baja: SOLO el backend (api/crear-usuario, api/eliminar-usuario, api/estado-cuenta).
      allow create, delete: if false;

      allow update: if activo() && (
        // Uno mismo: únicamente su estado de sesión.
        (request.auth.uid == userId &&
          camposCambiados().hasOnly(['isOnline', 'currentSessionId', 'lastLogin']))
        // Owner: puede editar todo salvo cuenta/correo (eso lo maneja el backend).
        || (esOwner() &&
          camposCambiados().hasOnly(['nombre', 'edad', 'agrupacion', 'instrumento', 'estado', 'nucleo', 'rango']))
        // Gestores: solo roles ESTRICTAMENTE inferiores; nunca tocan rango ni cuenta.
        || (camposCambiados().hasOnly(['nombre', 'edad', 'agrupacion', 'instrumento', 'estado', 'nucleo']) && (
              (rol() == 'director_nacional' &&
                resource.data.rango in ['director_regional', 'director_nucleo', 'admin', 'profesor', 'estudiante'])
           || (esRegional() && me().estado != '' && resource.data.estado == me().estado &&
                request.resource.data.estado == resource.data.estado &&
                resource.data.rango in ['director_nucleo', 'admin', 'profesor', 'estudiante'])
           || (esDirNucleo() && esMiNucleo(resource.data.nucleo) &&
                request.resource.data.nucleo == resource.data.nucleo &&
                request.resource.data.estado == resource.data.estado &&
                resource.data.rango in ['admin', 'profesor', 'estudiante'])
           || (esAdmin() && esMiNucleo(resource.data.nucleo) &&
                request.resource.data.nucleo == resource.data.nucleo &&
                request.resource.data.estado == resource.data.estado &&
                resource.data.rango in ['profesor', 'estudiante'])
        ))
      );
    }

    // ---------- CARRUSEL NACIONAL (portada pública) ----------
    match /carrusel/{docId} {
      allow read: if true;
      allow write: if activo() && esNacional();
    }

    // ---------- FLYERS (por núcleo) ----------
    match /flyers/{docId} {
      allow read: if activo() && (multiNucleo() || esMiNucleo(resource.data.nucleo));
      allow create, update: if activo() && (
        multiNucleo() ||
        ((esDirNucleo() || esAdmin()) && esMiNucleo(request.resource.data.nucleo)));
      allow delete: if activo() && (
        multiNucleo() ||
        ((esDirNucleo() || esAdmin()) && esMiNucleo(resource.data.nucleo)));
    }

    // ---------- EVENTOS (por núcleo + audiencia) ----------
    // "audiencia" es una lista de textos: 'todos', 'profesor', 'estudiante' y/o
    // 'agr:<nombre de la agrupación>'. Los gestores ven todo su núcleo; un
    // profesor/estudiante solo ve lo dirigido a "todos", a su rol o a su agrupación
    // (el front hace una consulta por cada una de esas tres posibilidades).
    match /eventos/{docId} {
      allow read: if activo() && (
        multiNucleo()
        || (esMiNucleo(resource.data.nucleo) && (
              esGestor()
              || 'todos' in resource.data.audiencia
              || rol() in resource.data.audiencia
              || ('agr:' + me().get('agrupacion', '')) in resource.data.audiencia
           )));
      allow create, update: if activo() && request.resource.data.audiencia is list && (
        multiNucleo() ||
        ((esDirNucleo() || esAdmin()) && esMiNucleo(request.resource.data.nucleo)));
      allow delete: if activo() && (
        multiNucleo() ||
        ((esDirNucleo() || esAdmin()) && esMiNucleo(resource.data.nucleo)));
    }

    // ---------- NÚCLEOS (lista maestra {nombre, estado}) ----------
    match /nucleos/{docId} {
      allow read: if activo();
      allow create: if activo() && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80
        && (esNacional() || (esRegional() && request.resource.data.estado == me().estado));
      allow update: if activo() && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80
        && request.resource.data.estado == resource.data.estado
        && (esNacional() || (esRegional() && resource.data.estado == me().estado));
      allow delete: if activo() && (esNacional() || (esRegional() && resource.data.estado == me().estado));
    }

    // ---------- AGRUPACIONES (por núcleo) ----------
    match /agrupaciones/{docId} {
      allow read: if activo() && (multiNucleo() || esMiNucleo(resource.data.nucleo));
      allow create, update: if activo() && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80
        && (multiNucleo() ||
           ((esDirNucleo() || esAdmin()) && esMiNucleo(request.resource.data.nucleo)));
      allow delete: if activo() && (
        multiNucleo() ||
        ((esDirNucleo() || esAdmin()) && esMiNucleo(resource.data.nucleo)));
    }

    // ---------- PIEZAS y PARTITURAS (por núcleo) ----------
    // Escriben: directivos, admin y profesores — cada uno solo en su núcleo.
    match /piezas/{docId} {
      allow read: if activo() && (multiNucleo() || esMiNucleo(resource.data.nucleo));
      allow create: if activo() && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 120
        && (multiNucleo() ||
           (rol() in ['director_nucleo', 'admin', 'profesor'] && esMiNucleo(request.resource.data.nucleo)));
      allow update: if activo() && request.resource.data.nucleo == resource.data.nucleo
        && (multiNucleo() ||
           (rol() in ['director_nucleo', 'admin', 'profesor'] && esMiNucleo(resource.data.nucleo)));
      allow delete: if activo() && (
        multiNucleo() ||
        (rol() in ['director_nucleo', 'admin', 'profesor'] && esMiNucleo(resource.data.nucleo)));
    }
    match /partituras/{docId} {
      allow read: if activo() && (multiNucleo() || esMiNucleo(resource.data.nucleo));
      allow create: if activo() && (
        multiNucleo() ||
        (rol() in ['director_nucleo', 'admin', 'profesor'] && esMiNucleo(request.resource.data.nucleo)));
      allow update: if activo() && request.resource.data.nucleo == resource.data.nucleo
        && (multiNucleo() ||
           (rol() in ['director_nucleo', 'admin', 'profesor'] && esMiNucleo(resource.data.nucleo)));
      allow delete: if activo() && (
        multiNucleo() ||
        (rol() in ['director_nucleo', 'admin', 'profesor'] && esMiNucleo(resource.data.nucleo)));
    }

    // ---------- FORMACIÓN (nacional: la lee todo el que tenga cuenta activa) ----------
    match /formacion_modulos/{docId} {
      allow read: if activo();
      allow write: if activo() && esGestor();
    }
    match /formacion_niveles/{docId} {
      allow read: if activo();
      allow write: if activo() && esGestor();
    }

    // ---------- Colecciones que usa SOLO el backend (el Admin SDK ignora estas reglas) ----------
    match /_limites_uso/{docId} { allow read, write: if false; }
    match /_meta/{docId}        { allow read, write: if false; }
  }
}
